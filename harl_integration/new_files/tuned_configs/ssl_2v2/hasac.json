{
    "main_args": {
        "algo": "hasac",
        "env": "ssl_2v2",
        "exp_name": "ssl2v2_hasac",
        "load_config": ""
    },
    "algo_args": {
        "seed": {
            "seed_specify": true,
            "seed": 1
        },
        "device": {
            "cuda": true,
            "cuda_deterministic": true,
            "torch_threads": 4
        },
        "train": {
            "n_rollout_threads": 20,
            "num_env_steps": 20000000,
            "warmup_steps": 10000,
            "train_interval": 50,
            "update_per_train": 1,
            "log_interval": null,
            "eval_interval": 7000,
            "use_valuenorm": true,
            "use_linear_lr_decay": true,
            "use_proper_time_limits": true,
            "model_dir": null
        },
        "eval": {
            "use_eval": true,
            "n_eval_rollout_threads": 20,
            "eval_episodes": 40
        },
        "render": {
            "use_render": false,
            "render_episodes": 10
        },
        "model": {
            "hidden_sizes": [256, 256],
            "activation_func": "relu",
            "use_feature_normalization": true,
            "final_activation_func": "tanh",
            "initialization_method": "orthogonal_",
            "gain": 0.01,
            "lr": 0.0005,
            "critic_lr": 0.0005
        },
        "algo": {
            "auto_alpha": false,
            "alpha": 0.001,
            "alpha_lr": 0.0003,
            "gamma": 0.99,
            "buffer_size": 1000000,
            "batch_size": 1000,
            "polyak": 0.005,
            "n_step": 5,
            "use_huber_loss": true,
            "use_policy_active_masks": true,
            "huber_delta": 10.0,
            "share_param": true,
            "fixed_order": false
        },
        "logger": {
            "log_dir": "./results"
        }
    },
    "env_args": {
        "reward_type": "dense",
        "frozen_path": null,
        "role_index": false,
        "oob_grace_steps": 0,
        "curriculum_level": 1,
        "curriculum_target_level": 5,
        "curriculum_threshold": 0.9,
        "curriculum_window": 200
    }
}
