{
    "main_args": {
        "algo": "hasac",
        "env": "ssl_2v2",
        "exp_name": "ssl2v2_hasac_lvl1",
        "load_config": ""
    },
    "algo_args": {
        "seed": {
            "seed_specify": true,
            "seed": 822
        },
        "device": {
            "cuda": true,
            "cuda_deterministic": false,
            "torch_threads": 4
        },
        "train": {
            "n_rollout_threads": 24,
            "num_env_steps": 4000000,
            "warmup_steps": 10000,
            "train_interval": 50,
            "update_per_train": 1,
            "log_interval": null,
            "eval_interval": 25000,
            "use_valuenorm": true,
            "use_linear_lr_decay": false,
            "use_proper_time_limits": true,
            "model_dir": null
        },
        "eval": {
            "use_eval": true,
            "n_eval_rollout_threads": 8,
            "eval_episodes": 40
        },
        "render": {
            "use_render": false,
            "render_episodes": 10
        },
        "model": {
            "hidden_sizes": [512, 512, 512],
            "activation_func": "relu",
            "use_feature_normalization": true,
            "final_activation_func": "tanh",
            "initialization_method": "orthogonal_",
            "gain": 0.01,
            "lr": 0.0003,
            "critic_lr": 0.0003
        },
        "algo": {
            "auto_alpha": true,
            "alpha": 0.2,
            "alpha_lr": 0.0003,
            "gamma": 0.99,
            "buffer_size": 200000,
            "batch_size": 1024,
            "polyak": 0.005,
            "n_step": 20,
            "use_huber_loss": true,
            "use_policy_active_masks": true,
            "huber_delta": 10.0,
            "share_param": true,
            "fixed_order": false
        },
        "logger": {
            "log_dir": "./results"
        }
    },
    "env_args": {
        "reward_type": "dense",
        "frozen_path": null,
        "role_index": false,
        "oob_grace_steps": 0,
        "curriculum_level": 1
    }
}
